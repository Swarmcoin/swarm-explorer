<a href="#explorer-content" class="sw-skip">Skip to explorer content</a>
<header class="sw-header">
  <a href="/" class="sw-brand" aria-label="SWARM explorer home">
    <img src="/images/swarm-explorer-mark.svg" width="36" height="36" alt=""/>
    <span>SWARM<small>EXPLORER</small></span>
    <%= if ZcashExplorer.Swarm.mainnet?() do %>
      <span class="sw-net-chip sw-net-chip-mainnet" data-network-chip="mainnet">MAINNET</span>
    <% else %>
      <span class="sw-net-chip sw-net-chip-testnet" data-network-chip="testnet">TESTNET</span>
    <% end %>
  </a>
  <nav class="sw-nav" aria-label="Sections">
    <a href="/">Overview</a><a href="/blocks">Blocks</a><a href="/mempool">Mempool</a>
    <a href="/blockchain-info">Shielded pools</a><a href="/nodes">Peers</a><a href="/broadcast">Broadcast</a>
  </nav>
  <a class="sw-home-link" href="https://swarm.green" rel="noreferrer">swarm.green ↗</a>
</header>
<div class="sw-utility">
  <span class="sw-utility-label">Explore <%= @network_name %></span>
  <form action="/search" class="sw-search sw-header-search" role="search">
    <label for="search" class="sr-only">Search a height, hash, transaction or address</label>
    <input id="search" name="qs" type="search" required placeholder="Height, hash, transaction or address" autocomplete="off" spellcheck="false"/>
    <button type="submit" class="sw-btn sw-btn-quiet">Search <span aria-hidden="true">↗</span></button>
  </form>
</div>
